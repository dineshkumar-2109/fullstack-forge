# Tasklane configuration. Copy to .env (never commit .env) or set these in your platform.
# Every variable is validated at startup; the process exits with a clear message if one is invalid.

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# SQLite file path (single instance). Mount a persistent volume at this path in production.
DATABASE_PATH=./data/tasklane.db
# Session lifetime in hours (1..2160)
SESSION_TTL_HOURS=336
# debug | info | warn | error | silent
LOG_LEVEL=info
# true only when running behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# Exact public origin, used for CSRF origin checks behind proxies, e.g. https://tasklane.example.com
PUBLIC_ORIGIN=
MAX_BODY_BYTES=65536
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=300
